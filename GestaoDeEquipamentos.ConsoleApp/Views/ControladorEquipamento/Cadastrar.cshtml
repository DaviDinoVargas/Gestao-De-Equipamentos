@model GestaoDeEquipamentos.ConsoleApp.Models.CadastrarEquipamentoViewModel
<link rel="stylesheet" href="~/css/estiloEquipamentos.css" />
<h2>Cadastrar Equipamento</h2>

<form method="post">
    <label>Nome:</label>
    <input name="Nome" value="@Model.Nome" required />

    <label>Preço de Aquisição:</label>
    <input name="PrecoAquisicao" type="number" step="0.01" value="@Model.PrecoAquisicao" required />

    <label>Data de Fabricação:</label>
    <input name="DataFabricacao" type="date" value="@Model.DataFabricacao.ToString("yyyy-MM-dd")" required />

    <label>Fabricante:</label>
    <select name="FabricanteId" required>
        @foreach (var fabricante in Model.Fabricantes)
        {
            <option value="@fabricante.Id" @(fabricante.Id == Model.FabricanteId ? "selected" : "")>@fabricante.Nome</option>
        }
    </select>

    <button type="submit">Cadastrar</button>
</form>