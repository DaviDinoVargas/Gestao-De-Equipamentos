@using GestaoDeEquipamentos.ConsoleApp.Models
@using GestaoDeEquipamentos.ConsoleApp.ModuloEquipamento
@using GestaoDeEquipamentos.ConsoleApp.ModuloFabricante

@model CadastrarEquipamentoViewModel

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Cadastro de Equipamento - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estilo.css" />
    <link rel="stylesheet" href="~/css/estiloCadastrarFabricante.css" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/equipamentos/cadastrar">Cadastrar Novo Equipamento</a></li>
            <li><a href="/equipamentos/visualizar">Visualizar Equipamentos</a></li>
        </ul>
    </aside>

    <main>
        <div class="content">
            <h2>Cadastro de Equipamento</h2>
            <form method="post" action="/equipamentos/cadastrar">
                <div class="form-group">
                    <label for="nome">Nome:</label>
                    <input type="text" id="nome" name="nome" value="@Model.Nome" required />
                </div>
                <div class="form-group">
                    <label for="precoAquisicao">Preço de Aquisição:</label>
                    <input type="number" id="precoAquisicao" name="precoAquisicao" value="@Model.PrecoAquisicao" required />
                </div>
                <div class="form-group">
                    <label for="dataFabricacao">Data de Fabricação:</label>
                    <input type="date" id="dataFabricacao" name="dataFabricacao" value="@Model.DataFabricacao.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="form-group2">
                    <label for="fabricante">Fabricante:</label>
                    <select id="fabricante" name="FabricanteId" required>
                        @foreach (var fabricante in Model.FabricantesDisponiveis)
                        {
                            <option value="@fabricante.Id">@fabricante.Nome</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn">Cadastrar</button>
            </form>
        </div>
    </main>
</body>
</html>
