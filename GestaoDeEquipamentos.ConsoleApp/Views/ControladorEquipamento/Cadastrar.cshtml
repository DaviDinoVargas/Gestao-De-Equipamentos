@model GestaoDeEquipamentos.ConsoleApp.Models.CadastrarEquipamentoViewModel
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Equipamento - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estilo.css" />
    <link rel="stylesheet" href="~/css/estiloCada.css" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <div class="nav-container">
                <div class="hamburger-lines">
                    <span class="line line1"></span>
                    <span class="line line2"></span>
                    <span class="line line3"></span>
                </div>
                <h1>Gestão de Equipamentos</h1>
            </div>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/fabricantes/cadastrar">Cadastrar Novo Fabricante</a></li>
            <li><a href="/equipamentos/cadastrar">Cadastrar Novo Equipamento</a></li>
            <li><a href="/fabricantes/visualizar">Visualizar Fabricantes</a></li>
            <li><a href="/equipamentos/visualizar">Visualizar Equipamentos</a></li>
        </ul>
    </aside>

    <main>
        <div class="content">
            <h2>Cadastro de Equipamento</h2>
            <form method="post" action="/equipamentos/cadastrar">
                <div class="form-group">
                    <label for="nome">Nome:</label>
                    <input id="nome" name="Nome" value="@Model.Nome" required />
                </div>

                <div class="form-group">
                    <label for="preco">Preço de Aquisição:</label>
                    <input id="preco" name="PrecoAquisicao" type="number" step="0.01" value="@Model.PrecoAquisicao" required />
                </div>

                <div class="form-group">
                    <label for="dataFabricacao">Data de Fabricação:</label>
                    <input id="dataFabricacao" name="DataFabricacao" type="date" value="@Model.DataFabricacao.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="form-group">
                    <label for="fabricante">Fabricante:</label>
                    <select id="fabricante" name="FabricanteId" required>
                        @foreach (var fabricante in Model.Fabricantes)
                        {
                            <option value="@fabricante.Id" @(fabricante.Id == Model.FabricanteId ? "selected" : "")>
                                @fabricante.Nome
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn">Cadastrar</button>
            </form>
        </div>
    </main>
</body>
</html>