@{
    ViewBag.Title = "Cadastrar Equipamento";
    List<GestaoDeEquipamentos.ConsoleApp.ModuloFabricante.Fabricante> fabricantes = ViewBag.Fabricantes;
}
<h2>Cadastrar Equipamento</h2>
<form method="post">
    <label>Nome:</label>
    <input name="nome" required />
    <label>Preço de Aquisição:</label>
    <input name="precoAquisicao" type="number" step="0.01" required />
    <label>Data de Fabricação:</label>
    <input name="dataFabricacao" type="date" required />
    <label>Fabricante:</label>
    <select name="fabricanteId" required>
        @foreach (var fabricante in fabricantes)
        {
            <option value="@fabricante.Id">@fabricante.Nome</option>
        }
    </select>
    <button type="submit">Cadastrar</button>
</form>
