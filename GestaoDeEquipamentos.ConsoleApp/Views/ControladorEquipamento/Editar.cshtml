@{
    ViewBag.Title = "Editar Equipamento";
    var equipamento = ViewBag.Equipamento as GestaoDeEquipamentos.ConsoleApp.ModuloEquipamento.Equipamento;
    List<GestaoDeEquipamentos.ConsoleApp.ModuloFabricante.Fabricante> fabricantes = ViewBag.Fabricantes;
}
<h2>Editar Equipamento</h2>
<form method="post">
    <label>Nome:</label>
    <input name="nome" value="@equipamento.Nome" required />
    <label>Preço de Aquisição:</label>
    <input name="precoAquisicao" value="@equipamento.PrecoAquisicao" type="number" step="0.01" required />
    <label>Data de Fabricação:</label>
    <input name="dataFabricacao" value="@equipamento.DataFabricacao.ToString("yyyy-MM-dd")" type="date" required />
    <label>Fabricante:</label>
    <select name="fabricanteId" required>
        @foreach (var fabricante in fabricantes)
        {
            <option value="@fabricante.Id" @(fabricante.Id == equipamento.Fabricante.Id ? "selected" : "")>@fabricante.Nome</option>
        }
    </select>
    <button type="submit">Salvar</button>
</form>
