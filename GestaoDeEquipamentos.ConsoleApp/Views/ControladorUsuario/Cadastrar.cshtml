@using GestaoDeEquipamentos.ConsoleApp.Models
@using GestaoDeEquipamentos.ConsoleApp.ModuloUsuario

@model CadastrarUsuarioViewModel

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Cadastro de Usuário - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estilo.css" />
    <link rel="stylesheet" href="~/css/estiloCadastrarFabricante.css" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/usuarios/cadastrar">Cadastrar Novo Usuário</a></li>
            <li><a href="/usuarios/visualizar">Visualizar Usuários</a></li>
        </ul>
    </aside>

    <main>
        <div class="content">
            <h2>Cadastro de Usuário</h2>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Erros as string))
            {
                <div class="erros">
                    <p>@ViewBag.Erros</p>
                </div>
            }

            <form method="post" action="/usuarios/cadastrar">
                <div class="form-group">
                    <label for="nome">Nome:</label>
                    <input type="text" id="nome" name="nome" value="@Model.Nome" required />
                </div>
                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" value="@Model.Email" required />
                </div>
                <div class="form-group">
                    <label for="telefone">Telefone:</label>
                    <input type="text" id="telefone" name="telefone" value="@Model.Telefone" required />
                </div>
                <div class="form-group">
                    <label for="documento">Documento (CPF/CNPJ):</label>
                    <input type="text" id="documento" name="documento" value="@Model.Documento" required />
                </div>
                <div class="form-group2">
                    <label for="tipoDocumento">Tipo de Documento:</label>
                    <select id="tipoDocumento" name="tipoDocumento" required>
                        <option value="">Selecione</option>
                        <option value="CPF" @(Model.TipoDocumento == TipoDocumento.CPF ? "selected" : "")>CPF</option>
                        <option value="CNPJ" @(Model.TipoDocumento == TipoDocumento.CNPJ ? "selected" : "")>CNPJ</option>
                    </select>
                </div>
                <button type="submit" class="btn">Cadastrar</button>
            </form>
        </div>
    </main>
</body>
</html>
