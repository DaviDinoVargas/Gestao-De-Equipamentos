@using GestaoDeEquipamentos.ConsoleApp.Models
@using GestaoDeEquipamentos.ConsoleApp.ModuloFabricante

@model ExcluirFabricanteViewModel;


<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Excluir Fabricante - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estilo.css" />
    <link rel="stylesheet" href="~/css/estiloExcluirFabricante.css" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/fabricantes/cadastrar">Cadastrar Novo Fabricante</a></li>
            <li><a href="/fabricantes/visualizar">Visualizar Fabricantes</a></li>
        </ul>
    </aside>

    <main>
        <div class="content">
            <h2>Exclusão de Fabricante</h2>
            <p>Tem certeza que deseja excluir o fabricante <strong>@Model.Nome</strong>?</p>
            <form method="post" action="/fabricantes/excluir/@Model.Id">
                <button type="submit" class="btn btn-excluir">Excluir</button>
                <a href="/fabricantes/visualizar" class="btn btn-secundario">Cancelar</a>
            </form>
        </div>
    </main>
</body>
</html>