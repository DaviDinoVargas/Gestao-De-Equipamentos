@using GestaoDeEquipamentos.ConsoleApp.ModuloFabricante

@{
    List<Fabricante> fabricantes = ViewBag.Fabricantes;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Visualização de Fabricantes - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estilo.css" />
    <link rel="stylesheet" href="~/css/estiloVisualizarFabricante.css" />
</head>
<body>
    <div class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </div>

    <div class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/fabricantes/cadastrar">Cadastrar Novo Fabricante</a></li>
        </ul>
    </div>
    <div class="card-container">
        @foreach (Fabricante f in fabricantes)
        {
            <div class="card">
                <div class="card-info">
                    <h4>@f.Nome</h4>
                    <p><strong>Telefone:</strong> @f.Telefone</p>
                    <p><strong>Email:</strong> @f.Email</p> 
                </div>

                <div class="card-actions">
                    <a class="btn-editar" href="/fabricantes/editar/@f.Id">Editar</a>
                    <a class="btn-excluir" href="/fabricantes/excluir/@f.Id">Excluir</a>
                </div>
            </div>
        }
    </div>
</body>
</html>
