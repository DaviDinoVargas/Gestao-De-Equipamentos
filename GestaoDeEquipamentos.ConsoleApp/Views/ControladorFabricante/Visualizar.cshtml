﻿@using GestaoDeEquipamentos.ConsoleApp.Models
@using GestaoDeEquipamentos.ConsoleApp.ModuloFabricante

@model VisualizarFabricantesViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Visualizar Fabricantes - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estilo.css" />
    <link rel="stylesheet" href="~/css/estiloVisualizarFabricante.css" />

</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/fabricantes/cadastrar">Cadastrar Novo Fabricante</a></li>
        </ul>
    </aside>

    <main>
        <div class="card-container">
            <ul class="fabricantes-list">
                @foreach (DetalhesFabricanteViewModel f in Model.Registros)
                {
                    <li>
                        <div class="card">
                            <div class="card-info">
                                <h4>@f.Nome</h4>
                                <p><strong>Telefone:</strong> @f.Telefone</p>
                                <p><strong>Email:</strong> @f.Email</p>
                                <p class="descricao">@f.ToString()</p>
                            </div>
                            <div class="card-actions">
                                <a class="btn-editar" href="/fabricantes/editar/@f.Id">Editar</a>
                                <a class="btn-excluir" href="/fabricantes/excluir/@f.Id">Excluir</a>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </main>
</body>
</html>