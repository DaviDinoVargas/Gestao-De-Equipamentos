@using GestaoDeEquipamentos.ConsoleApp.Models
@using GestaoDeEquipamentos.ConsoleApp.ModuloChamado

@model EditarChamadoViewModel

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Editar Chamado - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estiloCadastrarChamado.css" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/chamados/cadastrar">Cadastrar Novo Chamado</a></li>
            <li><a href="/chamados/visualizar">Visualizar Chamados</a></li>
        </ul>
    </aside>

    <main>
        <div class="content">
            <h2>Edição de Chamado</h2>
            <form method="post" action="/chamados/editar/@Model.Id">
                <div class="form-group">
                    <label for="titulo">Título:</label>
                    <input type="text" id="titulo" name="titulo" value="@Model.Titulo" required />
                </div>

                <div class="form-group3">
                    <label for="descricao">Descrição:</label>
                    <textarea id="descricao" name="descricao" required>@Model.Descricao</textarea>
                </div>

                <div class="form-group2">
                    <label for="equipamento">Equipamento:</label>
                    <select id="equipamento" name="EquipamentoId" required>
                        @foreach (var equipamento in Model.EquipamentosDisponiveis)
                        {
                            <option value="@equipamento.Id" @(equipamento.Id == Model.EquipamentoId ? "selected" : "")>@equipamento.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-group2">
                    <label for="usuario">Usuário:</label>
                    <select id="usuario" name="UsuarioId" required>
                        @foreach (var usuario in Model.UsuariosDisponiveis)
                        {
                            <option value="@usuario.Id" @(usuario.Id == Model.UsuarioId ? "selected" : "")>@usuario.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-group2">
                    <label for="funcionario">Funcionário Responsável:</label>
                    <select id="funcionario" name="FuncionarioResponsavelId" required>
                        @foreach (var funcionario in Model.FuncionariosDisponiveis)
                        {
                            <option value="@funcionario.Id" @(funcionario.Id == Model.FuncionarioResponsavelId ? "selected" : "")>@funcionario.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-group2">
                    <label for="status">Status:</label>
                    <select id="status" name="Status" required>
                        <option value="Aberto" @(Model.Status == StatusChamado.Aberto ? "selected" : "")>Aberto</option>
                        <option value="Pendente" @(Model.Status == StatusChamado.Pendente ? "selected" : "")>Pendente</option>
                        <option value="Fechado" @(Model.Status == StatusChamado.Fechado ? "selected" : "")>Fechado</option>
                    </select>
                </div>

                <button type="submit" class="btn">Salvar Alterações</button>
            </form>
        </div>
    </main>
</body>
</html>