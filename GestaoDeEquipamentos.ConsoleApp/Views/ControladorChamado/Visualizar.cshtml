@using GestaoDeEquipamentos.ConsoleApp.Models
@using System.Text.Json
@using GestaoDeEquipamentos.ConsoleApp.ModuloChamado

@model VisualizarChamadosViewModel

@{
    ViewData["Title"] = "Chamados";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Visualizar Chamados - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estiloVisualizarTable.css" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/chamados/cadastrar">Cadastrar Novo Chamado</a></li>
        </ul>
    </aside>

    <div class="container">
        <header>
            <h1>Chamados Técnicos</h1>
            <input type="text" id="searchInput" placeholder="Pesquisar...">
            <div class="filters">
                <select id="sortFilter">
                    <option value="recent">Mais Recentes</option>
                    <option value="oldest">Mais Antigos</option>
                    <option value="az">A-Z</option>
                    <option value="za">Z-A</option>
                    <option value="diasMais">Dias em Aberto (Maior)</option>
                    <option value="diasMenos">Dias em Aberto (Menor)</option>
                </select>
            </div>
        </header>

        <div class="table-container">
            <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Descrição</th>
                    <th>Equipamento</th>
                    <th>Usuário</th>
                    <th>Abertura</th>
                    <th>Dias em Aberto</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="chamadosTable">
                @if (Model.Registros.Any())
                {
                    foreach (var chamado in Model.Registros)
                    {
                        <tr>
                            <td>@chamado.Id</td>
                            <td>@chamado.Titulo</td>
                            <td>@chamado.Descricao</td>
                            <td>@chamado.NomeEquipamento</td>
                            <td>@chamado.NomeUsuario</td>
                            <td>@chamado.DataAbertura.ToString("dd/MM/yyyy")</td>
                            <td>@chamado.DiasEmAberto</td>
                            <td>
                                <span class="status-badge status-@chamado.Status.ToLower()">@chamado.Status</span>
                            </td>
                            <td class="card-actions">
                                <a href="/chamados/visualizar/@chamado.Id" class="btn-detalhes">Detalhes</a>
                                <a href="/chamados/editar/@chamado.Id" class="btn-editar">Editar</a>
                                <a href="/chamados/excluir/@chamado.Id" class="btn-excluir">Excluir</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">Nenhum chamado encontrado.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>

    @{
        var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null };
        var dadosJson = JsonSerializer.Serialize(Model.Registros, jsonOptions);
    }

    <script>
        const chamados = @Html.Raw(dadosJson);
    </script>

    <script src="~/js/filtrarChamado.js"></script>
</body>
</html>