@using GestaoDeEquipamentos.ConsoleApp.Models
@using GestaoDeEquipamentos.ConsoleApp.ModuloChamado

@model CadastrarChamadoViewModel

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Cadastro de Chamado - Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estiloCadastrarChamado.css" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <h1>Gestão de Equipamentos</h1>
        </div>
    </header>

    <aside class="sidebar">
        <ul>
            <li><a href="/">Página Inicial</a></li>
            <li><a href="/chamados/cadastrar">Cadastrar Novo Chamado</a></li>
            <li><a href="/chamados/visualizar">Visualizar Chamados</a></li>
        </ul>
    </aside>

    <main>
        <div class="content">
            <h2>Cadastrar Chamado</h2>

            <form method="post" asp-action="Cadastrar">
                <div class="form-group">
                    <label for="Titulo">Título</label>
                    <input type="text" class="form-control" id="Titulo" name="Titulo" value="@Model.Titulo" required />
                </div>

                <div class="form-group">
                    <label for="Descricao">Descrição</label>
                    <textarea class="form-control" id="Descricao" name="Descricao" required>@Model.Descricao</textarea>
                </div>

                <div class="form-group">
                    <label for="EquipamentoId">Equipamento</label>
                    <select class="form-control" id="EquipamentoId" name="EquipamentoId" required>
                        <option value="">Selecione um equipamento</option>
                        @foreach (var equipamento in Model.EquipamentosDisponiveis)
                        {
                            <option value="@equipamento.Id">@equipamento.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="UsuarioId">Usuário</label>
                    <select class="form-control" id="UsuarioId" name="UsuarioId" required>
                        <option value="">Selecione um usuário</option>
                        @foreach (var usuario in Model.UsuariosDisponiveis)
                        {
                            <option value="@usuario.Id">@usuario.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="FuncionarioResponsavelId">Funcionário Responsável</label>
                    <select class="form-control" id="FuncionarioResponsavelId" name="FuncionarioResponsavelId" required>
                        <option value="">Selecione um funcionário</option>
                        @foreach (var funcionario in Model.FuncionariosDisponiveis)
                        {
                            <option value="@funcionario.Id">@funcionario.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="Status">Status</label>
                    <select class="form-control" id="Status" name="Status" required>
                        <option value="">Selecione o status</option>
                        @foreach (var status in Enum.GetValues(typeof(GestaoDeEquipamentos.ConsoleApp.ModuloChamado.StatusChamado)))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Salvar</button>
                <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Chamado")'">Cancelar</button>
            </form>
        </div>
    </main>
</body>
</html>