@using GestaoDeEquipamentos.ConsoleApp.Models
@using System.Text.Json
@using GestaoDeEquipamentos.ConsoleApp.ModuloChamado
@using static GestaoDeEquipamentos.ConsoleApp.Models.DetalhesCompletosChamadoViewModel

@model DashboardViewModel
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestão de Equipamentos</title>
    <link rel="stylesheet" href="~/css/estilo.css" />
    <link href="https://unpkg.com/boxicons@2.0.7/css/boxicons.min.css" rel="stylesheet" />
</head>
<body>
    <header class="header-nav">
        <div class="navbar">
            <div class="nav-container">
                <div class="hamburger-lines" id="hamburger">
                    <span class="line line1"></span>
                    <span class="line line2"></span>
                    <span class="line line3"></span>
                </div>
                <h1>Gestão de Equipamentos</h1>
            </div>
        </div>
    </header>

    <aside class="sidebar">
        <nav>
            <ul class="sidebar-menu">

                <li class="menu-item has-dropdown">
                    <a href="#" class="dropdown-toggle">
                        <i class='bx bxs-factory'></i>
                        <span>Fabricantes</span>
                        <i class='bx bx-chevron-down dropdown-icon'></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="/fabricantes/cadastrar"><i class='bx bx-plus-circle'></i> Cadastrar</a></li>
                        <li><a href="/fabricantes/visualizar"><i class='bx bx-show'></i> Visualizar</a></li>
                    </ul>
                </li>

                <li class="menu-item has-dropdown">
                    <a href="#" class="dropdown-toggle">
                        <i class='bx bx-hdd'></i>
                        <span>Equipamentos</span>
                        <i class='bx bx-chevron-down dropdown-icon'></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="/equipamentos/cadastrar"><i class='bx bx-plus-circle'></i> Cadastrar</a></li>
                        <li><a href="/equipamentos/visualizar"><i class='bx bx-show'></i> Visualizar</a></li>
                    </ul>
                </li>

                <li class="menu-item has-dropdown">
                    <a href="#" class="dropdown-toggle">
                        <i class='bx bx-user'></i>
                        <span>Usuários</span>
                        <i class='bx bx-chevron-down dropdown-icon'></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="/usuarios/cadastrar"><i class='bx bx-user-plus'></i> Cadastrar</a></li>
                        <li><a href="/usuarios/visualizar"><i class='bx bx-show'></i> Visualizar</a></li>
                    </ul>
                </li>

                <li class="menu-item has-dropdown">
                    <a href="#" class="dropdown-toggle">
                        <i class='bx bx-id-card'></i>
                        <span>Funcionários</span>
                        <i class='bx bx-chevron-down dropdown-icon'></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="/funcionarios/cadastrar"><i class='bx bx-user-plus'></i> Cadastrar</a></li>
                        <li><a href="/funcionarios/visualizar"><i class='bx bx-show'></i> Visualizar</a></li>
                    </ul>
                </li>

                <li class="menu-item has-dropdown">
                    <a href="#" class="dropdown-toggle">
                        <i class='bx bx-message-detail'></i>
                        <span>Chamados</span>
                        <i class='bx bx-chevron-down dropdown-icon'></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a href="/chamados/cadastrar"><i class='bx bx-message-add'></i> Cadastrar</a></li>
                        <li><a href="/chamados/visualizar"><i class='bx bx-show'></i> Visualizar</a></li>
                    </ul>
                </li>


                <li class="menu-item">
                    <a href="/">
                        <i class='bx bx-home'></i>
                        <span>Página Inicial</span>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <main>
        <div class="content">
            <h2>Gestão de Equipamentos</h2>
            <div style="height: 2000px;">
                <h1>Dashboard de Chamados</h1>

                <section class="resumo-cards">
                    <div class="card">Total: @Model.TotalChamados</div>
                    <div class="card">Abertos: @Model.ChamadosAbertos</div>
                    <div class="card">Pendentes: @Model.ChamadosPendentes</div>
                    <div class="card">Fechados (30 dias): @Model.ChamadosFechadosUltimos30Dias</div>
                    <div class="card">Média Dias em Aberto: @Model.MediaDiasEmAberto.ToString("F1")</div>
                </section>

                <div class="graficos">
                    <div style="height: 300px;">
                        <canvas id="graficoPizza"></canvas>
                    </div>
                    <div style="height: 300px;">
                        <canvas id="graficoEquipamento"></canvas>
                    </div>
                </div>

                <div class="chamado-container">
                    <div class="chamado-content">

                       
                        <div class="chamado-section">
                            <h3 class="chamados-criticos-title">Chamados Críticos</h3>
                            <div class="chamado-details">
                                <table class="tabela-detalhes">
                                    <thead>
                                        <tr>
                                            <th>Título</th>
                                            <th>Equipamento</th>
                                            <th>Dias</th>
                                            <th>Responsável</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var chamado in Model.ChamadosCriticos)
                                        {
                                            <tr>
                                                <td>@chamado.Titulo</td>
                                                <td>@chamado.NomeEquipamento</td>
                                                <td>@chamado.DiasEmAberto</td>
                                                <td>@chamado.NomeFuncionarioResponsavel</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                     
                        <div class="chamado-section">
                            <h3>Métricas de Desempenho</h3>
                            <div class="chamado-details">
                                <div class="detail-card">
                                    <h4>Taxa de Resolução</h4>
                                    <p>@Model.TaxaResolucao.ToString("P1")</p>
                                </div>
                                <div class="detail-card">
                                    <h4>Tempo Médio de Resolução</h4>
                                    <p>@Model.TempoMedioResolucao.ToString("F1") dias</p>
                                </div>
                            </div>
                        </div>

                       
                        <div class="chamado-section">
                            <h3>Atividades Recentes</h3>
                            <div class="timeline">
                                @foreach (var log in Model.LogsRecentes)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-date">@log.Data.ToString("g")</div>
                                        <div class="timeline-content">
                                            <p>@log.Acao</p>
                                            <div class="timeline-author">Por: @log.Responsavel</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>


                @{
                    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = null };
                }
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

                <script id="statusDataJson" type="application/json">
                    @Html.Raw(JsonSerializer.Serialize(Model.DistribuicaoPorStatus, jsonOptions))
                </script>

                <script id="equipamentoDataJson" type="application/json">
                    @Html.Raw(JsonSerializer.Serialize(Model.ChamadosPorEquipamento, jsonOptions))
                </script>

                <script id="tendenciaDataJson" type="application/json">
                    @Html.Raw(JsonSerializer.Serialize(Model.TendenciaResolucao, jsonOptions))
                </script>

                <script src="~/js/dashboard.js"></script>
                <script src="~/js/sidebar.js"></script>
            </div>
        </div>
    </main>   
   

</body>
</html>